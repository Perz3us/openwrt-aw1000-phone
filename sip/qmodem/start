[ -x /etc/init.d/qmodem_voip ] || exit 0
if [ "$(uci -q get qmodem_voip.main.enabled)" != 1 ]; then
	uci -q set qmodem_voip.main.enabled=1
	uci -q commit qmodem_voip
	/etc/init.d/qmodem_voip enable
	/etc/init.d/qmodem_voip restart
elif ! /etc/init.d/qmodem_voip running; then
	/etc/init.d/qmodem_voip enable
	/etc/init.d/qmodem_voip start
fi
[ -x /etc/init.d/qmodem_voip_sipd ] || exit 0
if [ "$(uci -q get qmodem_sip.inbound.enabled)" != 1 ] &&
   [ "$(uci -q get qmodem_sip.outbound.enabled)" != 1 ]; then
	uci -q set qmodem_sip.inbound.enabled=1
	uci -q commit qmodem_sip
	/etc/init.d/qmodem_voip_sipd enable
	/etc/init.d/qmodem_voip_sipd restart
	exit 0
fi
/etc/init.d/qmodem_voip_sipd enabled || /etc/init.d/qmodem_voip_sipd enable
/etc/init.d/qmodem_voip_sipd running || /etc/init.d/qmodem_voip_sipd start
exit 0
