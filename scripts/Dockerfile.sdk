FROM debian@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
	build-essential perl python3 python3-setuptools file rsync gawk unzip bzip2 xz-utils zstd \
	bison flex libncurses-dev wget git ca-certificates swig gettext libelf-dev \
	&& rm -rf /var/lib/apt/lists/*
